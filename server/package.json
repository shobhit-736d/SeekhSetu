    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^11.3.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.1.0",
    "pdf-parse": "^2.4.5"
  }
}
