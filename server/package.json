{
  "name": "seekhsetu-backend",
  "version": "1.0.0",
  "description": "SeekhSetu Placement OS Express and MongoDB Atlas API Server",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch --watch-path=.env index.js",
