# ========================================================
# SeekhSetu AI Placement Preparation Platform — Environment Config Template
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas Database Connection
# Replace with your actual MongoDB Atlas connection string:
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/seekhsetu_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/seekhsetu_db?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Google Gemini AI API Key (Stored securely on backend)
# Get your free Gemini API key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Client Environment Variables
VITE_API_BASE_URL=/api
VITE_GEMINI_API_KEY=your_optional_client_gemini_key_here
